{
  "name": "foxworks-dispatch",
  "version": "0.0.0",
  "private": true,
  "description": "CLI bridge between architect-chat prompts and Claude Code tmux panes.",
  "type": "module",
  "bin": {
    "fd": "dist/bin/fd.js"
  },
  "scripts": {
    "spike:01": "tsx spikes/01-tmux-send-keys.ts",
    "spike:02": "tsx spikes/02-tmux-capture.ts",
    "spike:03": "tsx spikes/03-tmux-has-session.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc && chmod +x dist/bin/fd.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^19.2.14",
    "ansi-to-html": "^0.7.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ink": "^7.0.1",
    "react": "^19.2.5",
    "zod": "^4.3.6"
  }
}
