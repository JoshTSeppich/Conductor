{
  "name": "dispatch-workstation",
  "version": "2.0.1",
  "private": true,
  "description": "Foxworks Workstation v3.0 — Electron desktop app embedding dispatch-web kanban + Sonnet 4.6 orchestrator chat panel.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build-coarchitect.mjs && node scripts/build-shell.mjs && node scripts/build-preload.mjs",
    "dev": "pnpm build && electron dist/main/main.js",
    "package": "pnpm build && electron-packager . dispatch-workstation --out=dist/packaged --overwrite --electron-version=41.3.0 --ignore=^/node_modules --ignore=^/spikes --ignore=^/src --ignore=^/test --ignore=^/scripts --ignore=^/coarchitect --ignore=^/SPIKES\\.md$ --ignore=^/tsconfig\\.json$ --ignore=^/vitest\\.config\\. --ignore=^/dist/packaged",
    "generate:section-10-5": "tsx scripts/generate-section-10-5.ts"
  },
  "devDependencies": {
    "@electron/packager": "^18.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "electron": "^41.3.0",
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "dispatch-core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
